# Optional — enables email delivery for quote form submissions
RESEND_API_KEY=
QUOTE_TO_EMAIL=hello@precisitile.com
QUOTE_FROM_EMAIL=quotes@precisitile.com

# Admin dashboard (/admin) — change these before going live
ADMIN_PASSWORD=precisi-local
ADMIN_SECRET=change-me-to-a-long-random-string

# Production on Amplify (optional until you scale storage to AWS)
# When both are set, quotes + photos use DynamoDB + S3 instead of local .data/
QUOTES_TABLE=
QUOTES_BUCKET=
