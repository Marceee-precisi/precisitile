# Admin dashboard (/admin) — change these before going live
ADMIN_PASSWORD=precisi-local
ADMIN_SECRET=change-me-to-a-long-random-string

# Production on Amplify (Ohio). Amplify blocks env names starting with AWS_
# so use ACCESS_KEY_ID / SECRET_ACCESS_KEY (not AWS_ACCESS_KEY_ID).
# SES sender/recipients (comma-separate multiple To addresses).
# Sender must be a Verified identity in SES (us-east-2).
# In SES Sandbox, every To address must also be verified.
QUOTE_FROM_EMAIL=admin@precisitile.com
QUOTE_TO_EMAIL=admin@precisitile.com
# SNS SMS: your phone in E.164 format (+17041234567). Needs AWS SMS origination for US.
QUOTE_ALERT_PHONE=
QUOTES_TABLE=precisitile-quotes
QUOTES_BUCKET=precisitile-quotes-photos
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
