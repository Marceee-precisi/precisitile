# Admin dashboard (/admin) — change these before going live
ADMIN_PASSWORD=precisi-local
ADMIN_SECRET=change-me-to-a-long-random-string

# Production on Amplify (Ohio). Amplify blocks env names starting with AWS_
# so use ACCESS_KEY_ID / SECRET_ACCESS_KEY (not AWS_ACCESS_KEY_ID).
# Same keys are used for DynamoDB, S3, SES, and SNS (us-east-2).
# SES sender: admin@precisitile.com must be a Verified identity in SES.
# SNS SMS: your phone in E.164 format (+17041234567). Verify the number in SNS sandbox first.
QUOTE_ALERT_PHONE=
QUOTES_TABLE=precisitile-quotes
QUOTES_BUCKET=precisitile-quotes-photos
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
